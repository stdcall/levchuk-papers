{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Левчук · Сборник: PDF",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Левчук · Сборник: prepare export",
        "Левчук · Сборник: export (Tinymist)",
        "Левчук · Сборник: validate PDF"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Левчук · Сборник: prepare export",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "scripts/project.py",
        "editor-prepare"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Левчук · Сборник: export (Tinymist)",
      "type": "typst",
      "command": "export",
      "export": {
        "format": "pdf",
        "inputPath": "${workspaceFolder}/content/main.typ",
        "pdf.pdfTags": true
      },
      "problemMatcher": []
    },
    {
      "label": "Левчук · Сборник: validate PDF",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "scripts/project.py",
        "editor-finish"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Левчук · Сборник: check",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "scripts/project.py",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Левчук · Сборник: lint",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "scripts/project.py",
        "lint"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Левчук · Сборник: PDF without editorial notes",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "scripts/project.py",
        "build-no-notes"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Левчук · Сборник: corrections",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "scripts/project.py",
        "corrections"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Левчук · Сборник: format",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "scripts/project.py",
        "fmt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
